{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "A choir member record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "voicePart": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["firstName", "lastName", "voicePart"]
    },
    "QuizScore": {
      "title": "QuizScore",
      "description": "Musical quiz attempt result",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhoto": { "type": "string" },
        "voicePart": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "dateKey": { "type": "string" },
        "timeTakenSeconds": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "userName", "score", "dateKey"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Choir roster directory"
    },
    "/quiz_scores/{scoreId}": {
      "schema": "QuizScore",
      "description": "Daily musical quiz scores"
    }
  }
}
